<UserControl x:Class="Devices_MVVM.Views.ParameterSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="设备参数设置"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="White"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <ComboBox ItemsSource="{Binding OnnxModelTypes}"
                          SelectedItem="{Binding SelectedOnnxModelType}"
                          Width="96"
                          Height="34"
                          Padding="8,0"
                          VerticalContentAlignment="Center"
                          Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding OnnxInputSizeOptions}"
                          SelectedItem="{Binding SelectedOnnxInputSize}"
                          Width="104"
                          Height="34"
                          Padding="8,0"
                          VerticalContentAlignment="Center"
                          Margin="0,0,8,0" />
                <Button Content="ONNX转Engine"
                        Command="{Binding ConvertOnnxToEngineCommand}"
                        Width="128"
                        Height="34"
                        Margin="0,0,10,0" />
                <Button Content="增加设备"
                        Command="{Binding AddDeviceCommand}"
                        Width="110"
                        Height="34" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DeviceParameterGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#08111F"
                                BorderBrush="#22304A"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="14"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="{Binding Title}"
                                           Foreground="White"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12" />

                                <ItemsControl Grid.Row="1"
                                              ItemsSource="{Binding Devices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0B1220"
                                                    BorderBrush="#22304A"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="12"
                                                    Width="{Binding CardWidth}"
                                                    Margin="0,0,12,12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="96" />
                                                            <ColumnDefinition Width="82" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="White"
                                                                       FontSize="16"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Id}"
                                                                       Foreground="#94A3B8"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1"
                                                                  Content="跳过创建"
                                                                  IsChecked="{Binding SkipCreate}"
                                                                  Foreground="White"
                                                                  VerticalAlignment="Center" />
                                                        <Button Grid.Column="2"
                                                                Content="删除"
                                                                Command="{Binding DataContext.DeleteDeviceCommand, ElementName=Root}"
                                                                CommandParameter="{Binding}"
                                                                Height="28"
                                                                Width="72"
                                                                Padding="4,0"
                                                                Margin="8,0,0,0" />
                                                    </Grid>

                                                    <Grid Grid.Row="1"
                                                          Margin="0,10,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,6,0">
                                                            <TextBlock Text="设备类型"
                                                                       Foreground="#94A3B8"
                                                                       FontSize="12" />
                                                            <TextBlock Text="{Binding DeviceType}"
                                                                       Height="28"
                                                                       Foreground="White"
                                                                       Background="#111827"
                                                                       Padding="8,5,8,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1"
                                                                    Margin="6,0,0,0">
                                                            <TextBlock Text="Kind"
                                                                       Foreground="#94A3B8"
                                                                       FontSize="12" />
                                                            <TextBlock Text="{Binding Kind}"
                                                                       Height="28"
                                                                       Foreground="White"
                                                                       Background="#111827"
                                                                       Padding="8,5,8,0" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <ItemsControl Grid.Row="2"
                                                                  ItemsSource="{Binding Settings}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,4,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="130" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Key}"
                                                                               Foreground="#94A3B8"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,10,0" />
                                                                    <TextBox Grid.Column="1"
                                                                             Height="28"
                                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                                                                        <TextBox.Style>
                                                                            <Style TargetType="TextBox">
                                                                                <Setter Property="TextWrapping" Value="NoWrap" />
                                                                                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Key}" Value="ConnectionString">
                                                                                        <Setter Property="Height" Value="34" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBox.Style>
                                                                    </TextBox>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="确认"
                    Command="{Binding ConfirmParameterSettingsCommand}"
                    Width="96"
                    Margin="0,0,10,0" />
            <Button Content="取消"
                    Command="{Binding CancelParameterSettingsCommand}"
                    Width="96"
                    Margin="0,0,10,0" />
           
            <Button Content="退出"
                    Command="{Binding ExitParameterSettingsCommand}"
                    Width="96" />
        </StackPanel>
    </Grid>
</UserControl>
